                            <div>
                                <span class="text-xs font-bold text-primary tracking-wider uppercase">Nivel Básico</span>
                                <h3 class="text-2xl font-bold text-secondary">Fundamentos de Electrónica y Componentes Pasivos</h3>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 w-fit">
